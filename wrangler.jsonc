{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gmgn-radar",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB" }
  ],
  "observability": { "enabled": true }
}
